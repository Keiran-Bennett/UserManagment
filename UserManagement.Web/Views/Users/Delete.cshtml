@using UserManagement.Web.Models.Users
@model UserDeleteViewModel

<h2>Delete User </h2>
@if(Model.IsSuccess)
{
<p>Are you sure you want to delete this user with the following details?</p>

<p><strong>Forename:</strong> @Model.User.Forename</p>
<p><strong>Surname:</strong> @Model.User.Surname</p>
<p><strong>Email:</strong> @Model.User.Email</p>
<p><strong>Date of Birth:</strong> @Model.User.DateOfBirth</p>
<p><strong>Is Active:</strong> @(Model.User.IsActive ? "Yes" : "No")</p>

    <form asp-controller="Users" asp-action="ConfirmDelete" method="post">
        <input type="hidden" name="id" value="@Model.User.Id" />
        <button type="submit" class="btn btn-danger">Delete User</button>
        <a asp-controller="Users" asp-action="List" class="btn btn-secondary">Cancel</a>

    </form>
}
else
{
    <p>There was an error retrieving the user</p>
}


@{
}
