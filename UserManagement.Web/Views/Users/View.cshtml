@using UserManagement.Web.Models.Users
@model UserViewModel

<h2>User Details</h2>
@if(Model.IsSuccess)
{
<p><strong>Forename:</strong> @Model.User.Forename</p>
<p><strong>Surname:</strong> @Model.User.Surname</p>
<p><strong>Email:</strong> @Model.User.Email</p>
<p><strong>Date of Birth:</strong> @Model.User.DateOfBirth</p>
<p><strong>Is Active:</strong> @(Model.User.IsActive ? "Yes" : "No")</p>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>User ID</th>
                <th>Date of Action</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.User.Logs)
            {
                <tr>
                    <td>@log.Id</td>
                    <td>@log.UserID</td>
                    <td>@log.DateofAction.ToString("dd-MM-yyyy")</td>
                    <td>@log.Details</td>
                </tr>
            }
        </tbody>
    </table>

<a asp-action="Edit" asp-route-id="@Model.User.Id" class="btn btn-primary">Edit</a>
<a asp-action="Delete" asp-route-id="@Model.User.Id" class="btn btn-danger">Delete</a>
}
else
{
    <p>There was an error retrieving the user</p>
}


