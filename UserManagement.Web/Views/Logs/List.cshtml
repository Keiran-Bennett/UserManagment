@using UserManagement.Services
@using UserManagement.Services.Logs
@model LogListViewModel

<h2>User List</h2>

<form method="get" asp-action="List" class="mb-3">
    <div class="row">
        <div class="col-6">
            <label for="startDate">Start Date</label>
            <input type="date" id="startDate" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-6">
            <label for="endDate">End Date</label>
            <input type="date" id="endDate" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-6">
            <label for="searchTerm">Description</label>
            <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search description..." />
        </div>
                <div class="col-6">
            <label for="type">Type</label>
            <select asp-for="Type" class="form-control"
                    asp-items="@(new SelectList(new[]
                            {
                                new { Value = "", Text = "All" },
                                new { Value = "1", Text = "Add" },
                                new { Value = "2", Text = "Delete" },
                                new { Value = "3", Text = "Update" }
                            }, "Value", "Text", Model.Type))">
            </select>
        </div>

        <div class="col d-flex align-items-center">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" id="isFilterEnabled" name="IsFilterEnabled"
                       value="true" @(Model.IsFilterEnabled ? "checked" : "") />
                <label class="form-check-label" for="isFilterEnabled">
                    Enable Filter
                </label>
            </div>

        </div>
        <div class="col d-flex align-items-end mt-3">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="List" class="btn btn-secondary ms-2">Clear</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateTime</th>
                <th>Type</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Logs)
            {
                <tr>
                    <td>
                        @user.Id
                    </td>
                    <td>
                        @user.DateofAction
                    </td>
                    <td>
                        @user.logType
                    </td>
                    <td>
                        @user.Details
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


