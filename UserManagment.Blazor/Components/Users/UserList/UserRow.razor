@using UserManagement.Web.Models.Users
<tr>
    <td>
        @User.Id
    </td>
    <td>
        @User.Forename
    </td>
    <td>
        @User.Surname
    </td>
    <td>
        @User.Email
    </td>
    <td>
        @User.DateOfBirth
    </td>
    <td>
        @(User.IsActive ? "Yes" : "No")
    </td>
    <td>
        <button @onclick="() => ViewUser(User.Id)" type="button" class="btn btn-primary">View</button>
        <button @onclick="() => DeleteUser(User.Id)" type="button" class="btn btn-danger">Delete</button>
    </td>
</tr>
@code {
    [Parameter]
    public UserDTO User { get; set; } = new();

    [Parameter]
    public EventCallback<int> ViewUserCallBack {get;set;}

    [Parameter]
    public EventCallback<int> DeleteUserCallBack { get; set; }


    protected async Task ViewUser(int id) => await ViewUserCallBack.InvokeAsync(id);

    protected async Task DeleteUser(int id) => await DeleteUserCallBack.InvokeAsync(id);


}
