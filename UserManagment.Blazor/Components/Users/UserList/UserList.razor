@page "/userlist"
@using UserManagement.Services
@using UserManagement.Services.Users
@using UserManagement.Services.Users.Models
@rendermode InteractiveServer


<PageTitle>User List</PageTitle>

<h1>User List</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Forename</th>
            <th>Surname</th>
            <th>Email</th>
            <th>Date of Birth</th>
            <th>Account Active</th>
            <th style="width: 1px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var user in Model.Users)
        {
            <UserRow User="user" ViewUserCallBack="ViewUser" DeleteUserCallBack="GoToDeleteUser" EditUserCallBack="GoToEditUser" />
        }
    </tbody>
</table>

<button @onclick="() => GoToAddUser()" type="button" class="btn btn-primary">Add User</button>

<UserListFilterOptions OptionChanged="ChangeFilterOption" ></UserListFilterOptions>

@code {
    [Inject]
    public APIService.IApiService API { get; set; } = default!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    protected UserListViewModel Model { get; set; } = new();
    protected string EndpointName => "users/List";

    protected async Task ChangeFilterOption(UserRetrievalType type)
    {
        string uri = $"{EndpointName}?userType={(int)type}";
        Model = await API.GetJsonAsync<UserListViewModel>(uri) ?? new();
    }


    protected override async Task OnParametersSetAsync()
    {
        Model = await API.GetJsonAsync<UserListViewModel>(EndpointName) ?? new();
    }

    protected void ViewUser(int ID) => NavigationManager.NavigateTo($"/userdetails/{ID}");
    protected void GoToDeleteUser(int ID) => NavigationManager.NavigateTo($"/deleteuser/{ID}");
    protected void GoToAddUser() => NavigationManager.NavigateTo($"/adduser");
    protected void GoToEditUser(int ID) => NavigationManager.NavigateTo($"/edituser/{ID}");
}
}

