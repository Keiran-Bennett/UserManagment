@page "/adduser"
@using UserManagement.Services.Users
@using UserManagement.Services.Users.Models
@using UserManagment.Blazor.Components.Shared

<h2>Add User</h2>

 @if(Model.IsSuccess == true)
{
    <UserForm OnSuccessCallback="HandleValidSubmit" OnCancelCallBack="Cancel" />
}
else
{
    <ErrorMessage/>
}

@code {
    [Inject]
    public APIService.IApiService API { get; set; } = default!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    protected UserAddViewModel Model { get; set; } = default!;

    protected override void OnInitialized()
    {
        Model = new() { IsSuccess = true };
    }

    private async Task HandleValidSubmit(UserFormDTO userForm)
    {
        var response = await API.PostJsonAsync<UserFormDTO,UserAddViewModel>("users/confirmadd", userForm) ?? new();
        if (response.IsSuccess)
            NavigationManager.NavigateTo("/userlist");
        else
            response.IsSuccess = false;   
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/userlist");
    }
}
