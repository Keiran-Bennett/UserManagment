@page "/adduser"
@using UserManagement.Web.Models.Users

<h2>Add User</h2>


    <EditForm Model="Model.User" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleValidSubmit" formname="AddUserForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="forename">Forename</label>
            <InputText id="forename" class="form-control" @bind-Value="Model.User.Forename" />
            <ValidationMessage For="@(() => Model.User.Forename)" />
        </div>

        <div class="form-group">
            <label for="surname">Surname</label>
            <InputText id="surname" class="form-control" @bind-Value="Model.User.Surname" />
            <ValidationMessage For="@(() => Model.User.Surname)" />
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="Model.User.Email" />
            <ValidationMessage For="@(() => Model.User.Email)" />
        </div>

        <div class="form-group">
            <label for="dob">Date of Birth</label>
            <InputDate id="dob" class="form-control" @bind-Value="Model.User.DateOfBirth" />
            <ValidationMessage For="@(() => Model.User.DateOfBirth)" />
        </div>

        <div class="form-group form-check">
            <InputCheckbox id="isActive" class="form-check-input" @bind-Value="Model.User.IsActive" />
            <label class="form-check-label" for="isActive">Is Active</label>
            <ValidationMessage For="@(() => Model.User.IsActive)" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>


@code {
    [Inject]
    public APIService.IApiService API { get; set; } = default!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    protected UserAddViewModel Model { get; set; } = default!;

    protected override void OnInitialized()
    {
        Model = new();
        if (Model.User == null)
            Model.User = new UserFormDTO();
    }

    private async Task HandleValidSubmit()
    {
        if (Model == null)
            return;

        var response = await API.PostJsonAsync<UserFormDTO,UserAddViewModel>("users/confirmadd", Model.User) ?? new();
        if (response.IsSuccess)
            NavigationManager.NavigateTo("/userlist");
        else
            response.IsSuccess = false;
        
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/userlist");
    }
}
